# PostgreSQL
DATABASE_URL=postgresql+psycopg2://keep_user:keep_password@localhost:5432/keep_db

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# OpenAI (backend-only, never exposed to frontend)
OPENAI_API_KEY=sk-your-key-here

# App
ENV=development
CORS_ORIGINS=http://localhost:5173
